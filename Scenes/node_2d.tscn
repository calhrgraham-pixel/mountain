[sub_resource type="ShaderMaterial" id="ShaderMaterial_g4v7s"]
shader = ExtResource("4_6whob")
shader_parameter/player_screen_pos = Vector2(0, 0)
shader_parameter/firefly_screen_pos = Vector2(0, 0)
shader_parameter/player_radius = 150.0
shader_parameter/firefly_radius = 80.0
shader_parameter/edge_softness = 40.0
shader_parameter/fog_color = Color(0, 0, 0, 1)
shader_parameter/noise_scale = 0.008
shader_parameter/noise_strength = 40.0
shader_parameter/scroll_speed = 0.05

[sub_resource type="GDScript" id="GDScript_yf5fn"]
resource_name = "fog"
script/source = "extends ColorRect

@onready var player: Node2D = %CharacterBody2D
@onready var firefly: Node2D = %Firefly

func _process(_delta: float) -> void:
	material.set_shader_parameter(\"player_screen_pos\", world_to_screen(player.global_position))
	material.set_shader_parameter(\"firefly_screen_pos\", world_to_screen(firefly.global_position))

func _ready() -> void:
	material.set_shader_parameter(\"player_radius\", 80.0)
	material.set_shader_parameter(\"firefly_radius\", 180.0)
	
func world_to_screen(world_pos: Vector2) -> Vector2:
	var canvas_transform = get_viewport().get_canvas_transform()
	return canvas_transform * world_pos
"

